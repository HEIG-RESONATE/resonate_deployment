# Copy to .env next to docker-compose.yml and set real values.
# Root password for MongoDB (also interpolated into the api's MONGO_HOST URL).
MONGO_PASSWORD=change_me
# Bearer token the agent presents to the MCP gateway.
MCP_GATEWAY_AUTH_TOKEN=change_me

# Only needed for the optional HTTPS overlay (docker-compose.tls.yml):
# SITE_ADDRESS  the public hostname Caddy serves and gets a Let's Encrypt cert
#               for (e.g. resonate.iict-heig-vd.ch). Use "localhost" to test
#               the overlay locally with Caddy's self-signed cert.
# ACME_EMAIL    contact address for Let's Encrypt registration.
#SITE_ADDRESS=resonate.iict-heig-vd.ch
#ACME_EMAIL=you@heig-vd.ch
